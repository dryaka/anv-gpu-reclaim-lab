+++ b/src/intel/vulkan/anv_gpu_reclaim.h
@@ -0,0 +1,81 @@
+/* SPDX-License-Identifier: MIT */
+#pragma once
+
+#include <ctype.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <string.h>
+
+/* Parse a kernel kB counter, rejecting signs, wrong units and overflow. */
+static inline bool
+anv_gpu_reclaim_counter(const char *p, const char *end, uint64_t *bytes)
+{
+   while (p < end && isspace((unsigned char)*p))
+      p++;
+   if (p == end || *p < '0' || *p > '9')
+      return false;
+   uint64_t value = 0;
+   while (p < end && *p >= '0' && *p <= '9') {
+      unsigned digit = *p++ - '0';
+      if (value > (UINT64_MAX - digit) / 10)
+         return false;
+      value = value * 10 + digit;
+   }
+   if (p == end || !isspace((unsigned char)*p))
+      return false;
+   while (p < end && isspace((unsigned char)*p))
+      p++;
+   if (end - p < 2 || p[0] != 'k' || p[1] != 'B')
+      return false;
+   p += 2;
+   while (p < end && isspace((unsigned char)*p))
+      p++;
+   if (p != end || value > UINT64_MAX / 1024)
+      return false;
+   *bytes = value * 1024;
+   return true;
+}
+
+/* Outputs are untouched on failure; missing GPUReclaim adds zero. */
+static inline bool
+anv_gpu_reclaim_parse(const char *text, uint64_t *available, uint64_t *reclaim)
+{
+   uint64_t a = 0, r = 0;
+   bool found_a = false, found_r = false;
+   for (const char *p = text; *p;) {
+      const char *end = strchr(p, '\n');
+      if (!end)
+         return false; /* Reject a truncated snapshot. */
+      if (end - p >= 13 && memcmp(p, "MemAvailable:", 13) == 0) {
+         if (found_a || !anv_gpu_reclaim_counter(p + 13, end, &a))
+            return false;
+         found_a = true;
+      } else if (end - p >= 11 && memcmp(p, "GPUReclaim:", 11) == 0) {
+         if (found_r || !anv_gpu_reclaim_counter(p + 11, end, &r))
+            return false;
+         found_r = true;
+      }
+      p = end + 1;
+   }
+   if (!found_a || a > UINT64_MAX - r)
+      return false;
+   *available = a;
+   *reclaim = r;
+   return true;
+}
+
+static inline bool
+anv_gpu_reclaim_limit(uint64_t available, uint64_t reclaim,
+                      uint64_t region_free, uint64_t region_size,
+                      uint64_t *result)
+{
+   if (available > UINT64_MAX - reclaim || region_free > region_size)
+      return false;
+   uint64_t value = available + reclaim;
+   if (value > region_free)
+      value = region_free;
+   if (value > region_size)
+      value = region_size;
+   *result = value;
+   return true;
+}
