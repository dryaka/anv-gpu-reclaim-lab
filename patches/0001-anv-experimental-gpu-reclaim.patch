+/* Experimental Linux/Xe integrated-GPU path. Shared Intel/util behavior is
+ * unchanged. Query a copy to recover the region bound BEFORE its host clamp.
+ */
+static void
+anv_apply_gpu_reclaim(struct anv_physical_device *device, int fd)
+{
+#ifdef __linux__
+   bool enabled = debug_get_bool_option("ANV_EXPERIMENTAL_GPU_RECLAIM", false);
+   bool diagnostic = debug_get_bool_option("ANV_EXPERIMENTAL_GPU_RECLAIM_DEBUG", false) &&
+                     !device->experimental_gpu_reclaim_budget_logged;
+   if (!enabled && !diagnostic)
+      return;
+   if (device->info.has_local_mem || device->info.kmd_type != INTEL_KMD_TYPE_XE)
+      return;
+
+   struct intel_device_info raw = device->info;
+   uint64_t available = 0, reclaim = 0, adjusted = device->sys.available;
+   bool valid = intel_device_info_xe_query_regions(fd, &raw, true);
+   char snapshot[16384];
+   int memfd = open("/proc/meminfo", O_RDONLY | O_CLOEXEC);
+   ssize_t count = memfd >= 0 ? read(memfd, snapshot, sizeof(snapshot) - 1) : -1;
+   if (memfd >= 0)
+      close(memfd);
+   if (count <= 0 || count == (ssize_t)(sizeof(snapshot) - 1)) {
+      valid = false;
+   } else {
+      snapshot[count] = 0;
+      valid = anv_gpu_reclaim_parse(snapshot, &available, &reclaim) && valid;
+   }
+   if (valid)
+      valid = anv_gpu_reclaim_limit(available, reclaim, raw.mem.sram.mappable.free,
+                                    raw.mem.sram.mappable.size, &adjusted);
+   uint64_t original = device->sys.available;
+   if (enabled && valid)
+      device->sys.available = adjusted;
+   if (diagnostic) {
+      fprintf(stderr, "ANV_GPU_RECLAIM enabled=%u valid=%u MemAvailable=%"PRIu64
+              " GPUReclaim=%"PRIu64" region_free=%"PRIu64" region_size=%"PRIu64
+              " original=%"PRIu64" selected=%"PRIu64" bytes\n",
+              enabled, valid, available, reclaim, raw.mem.sram.mappable.free,
+              raw.mem.sram.mappable.size, original, device->sys.available);
+   }
+#else
+   (void)device;
+   (void)fd;
+#endif
+}
